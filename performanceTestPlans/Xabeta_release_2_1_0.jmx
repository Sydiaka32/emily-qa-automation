        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener" enabled="false">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.text.SimpleDateFormat

// Only write for parent transaction
if (sampleEvent.getResult().isTransactionController()) {
    def f = new File(&quot;results/transaction_times.csv&quot;)
    if (!f.exists()) {
        f &lt;&lt; &quot;Timestamp,TestName,ThreadGroup,TransferID,StartTime,EndTime,TotalTimeMs,FinalStatus\n&quot;
    }
    
    def timestamp = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new Date())
    def totalTime = vars.get(&quot;totalProcessingTime&quot;) ?: &quot;0&quot;
    def status = vars.get(&quot;currentStatus&quot;) ?: &quot;UNKNOWN&quot;
    def transferId = vars.get(&quot;transfer_id&quot;) ?: &quot;N/A&quot;
    
    f &lt;&lt; &quot;${timestamp},${sampleEvent.getResult().getSampleLabel()},${ctx.getThreadGroup().getName()},&quot;
    f &lt;&lt; &quot;${transferId},${vars.get(&apos;startTime&apos;)},${System.currentTimeMillis()},&quot;
    f &lt;&lt; &quot;${totalTime},${status}\n&quot;
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Listener>
