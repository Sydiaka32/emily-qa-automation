          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor: status" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">status</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.content[0].status</stringProp>
