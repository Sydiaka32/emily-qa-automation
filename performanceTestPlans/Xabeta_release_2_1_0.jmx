        <hashTree>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request: Select timefor each transaction" enabled="true">
            <stringProp name="dataSource">db_results</stringProp>
            <stringProp name="query">SELECT
    clr_sys_ref,
    iso_msg_type,
    status,
    created_at,
    completed_at,
    completed_at::timestamptz - created_at::timestamptz AS processing_time
FROM transfer
WHERE created_at::timestamptz &gt;= TIMESTAMPTZ &apos;${__groovy(props.get(&quot;TEST_START_TS&quot;))}&apos;
  AND created_at::timestamptz &lt;=
      TIMESTAMPTZ &apos;${__groovy(
import java.time.Instant
def ts = props.get(&quot;TEST_START_TS&quot;)
ts != null ? Instant.parse(ts).plusSeconds(3600).toString() : Instant.now().plusSeconds(3600).toString()
)}&apos;
ORDER BY created_at::timestamptz;
</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="queryType">Select Statement</stringProp>
            <stringProp name="resultSetHandler">Store as Object</stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultVariable">db_row</stringProp>
            <stringProp name="variableNames"></stringProp>
          </JDBCSampler>
          <hashTree/>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request: Select avg time" enabled="true">
            <stringProp name="dataSource">db_results</stringProp>
            <stringProp name="query">SELECT
    COUNT(*) AS total_transfers,
    AVG(completed_at::timestamptz - created_at::timestamptz) AS avg_processing_time
FROM transfer
WHERE status = &apos;COMPLETED&apos;
  AND created_at::timestamptz BETWEEN
      TIMESTAMPTZ &apos;${__groovy(props.get(&quot;TEST_START_TS&quot;))}&apos;
      AND
      TIMESTAMPTZ &apos;${__groovy(
import java.time.Instant
def ts = props.get(&quot;TEST_START_TS&quot;)
ts != null ? Instant.parse(ts).plusSeconds(3600).toString() : Instant.now().plusSeconds(3600).toString()
)}&apos;;
</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="queryType">Select Statement</stringProp>
            <stringProp name="resultSetHandler">Store as Object</stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultVariable">db_row</stringProp>
            <stringProp name="variableNames"></stringProp>
          </JDBCSampler>
