      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="Test Fragment: Credit transfer" enabled="false"/>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request: Validate Credit transfer " enabled="true">
          <stringProp name="HTTPSampler.domain">${baseUrl}</stringProp>
          <stringProp name="HTTPSampler.protocol">${pt}</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/ct/credit-transfers/cct</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
    &quot;tx_id&quot;: &quot;sdafasdfasdff&quot;,&#xd;
    &quot;transfer_type&quot;: &quot;cct&quot;,&#xd;
    &quot;settlement_type&quot;: &quot;DNS&quot;,&#xd;
    &quot;creditor_currency&quot;: &quot;SAR&quot;,&#xd;
    &quot;end_to_end_id&quot;: &quot;asdfsdfasdf&quot;,&#xd;
    &quot;creditor_amount&quot;: 5,&#xd;
    &quot;remittance_information&quot;: &quot;&quot;,&#xd;
    &quot;creditor_xmi&quot;: &quot;XMBER006SAFF&quot;,&#xd;
    &quot;requested_execution_date&quot;: &quot;2025-12-24&quot;,&#xd;
    &quot;debtor&quot;: {&#xd;
        &quot;name&quot;: &quot;Debtor &quot;,&#xd;
        &quot;postal_address&quot;: {&#xd;
            &quot;country_code&quot;: &quot;AR&quot;,&#xd;
            &quot;address_line1&quot;: &quot;asd&quot;,&#xd;
            &quot;address_line2&quot;: &quot;asd&quot;,&#xd;
            &quot;address_line3&quot;: &quot;12&quot;&#xd;
        },&#xd;
        &quot;account_identifier&quot;: {&#xd;
            &quot;type&quot;: &quot;iban&quot;,&#xd;
            &quot;iban&quot;: &quot;CD1111111111111111111111111111111&quot;&#xd;
        }&#xd;
    },&#xd;
    &quot;creditor&quot;: {&#xd;
        &quot;name&quot;: &quot;Creditor nameaaaaaaaaa&quot;,&#xd;
        &quot;postal_address&quot;: {&#xd;
            &quot;country_code&quot;: &quot;HR&quot;,&#xd;
            &quot;address_line1&quot;: &quot;asdfasdf&quot;,&#xd;
            &quot;address_line2&quot;: &quot;fasdfsadf&quot;,&#xd;
            &quot;address_line3&quot;: &quot;asdfasdf&quot;&#xd;
        },&#xd;
        &quot;account_identifier&quot;: {&#xd;
            &quot;type&quot;: &quot;other&quot;,&#xd;
            &quot;identifier&quot;: &quot;CD111111111111111111111111111111&quot;&#xd;
        }&#xd;
    },&#xd;
    &quot;debtor_agent&quot;: {&#xd;
        &quot;agent_identifier&quot;: {&#xd;
            &quot;type&quot;: &quot;xmi&quot;,&#xd;
            &quot;xmi&quot;: &quot;XMBER007SAFF&quot;&#xd;
        }&#xd;
    },&#xd;
    &quot;creditor_agent&quot;: {&#xd;
        &quot;agent_identifier&quot;: {&#xd;
            &quot;type&quot;: &quot;xmi&quot;,&#xd;
            &quot;xmi&quot;: &quot;XMBER011BRFF&quot;&#xd;
        }&#xd;
    }&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${__P(global_token)}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor: validation id" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">validation_id</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.validation_id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="Scope.variable">validation_id</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor: validation_id" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">// Convert thread-local variable to global property
props.put(&quot;validation_id&quot;, vars.get(&quot;validation_id&quot;));</stringProp>
          </BeanShellPostProcessor>
          <hashTree/>
          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">// Get token from properties
String token = props.get(&quot;global_token&quot;);

if (token != null &amp;&amp; !token.isEmpty()) {
    vars.put(&quot;ct_token&quot;, token);
    log.info(&quot;Token retrieved: &quot; + token.substring(0, 20) + &quot;...&quot;);
} else {
    log.error(&quot;No token found in properties!&quot;);
    vars.put(&quot;ct_token&quot;, &quot;NOT_FOUND&quot;);
}</stringProp>
          </BeanShellPreProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request: Approve Credit transfer" enabled="true">
          <stringProp name="HTTPSampler.domain">${baseUrl}</stringProp>
          <stringProp name="HTTPSampler.protocol">${pt}</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/ct/credit-transfers/validations/${validation_id}/approve</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
