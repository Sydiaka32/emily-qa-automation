          <stringProp name="script">// This runs after each sample
if (sampleEvent.getResult().getSampleLabel().contains(&quot;Approve Credit Transfer&quot;)) {
    String referenceId = vars.get(&quot;reference_id&quot;)
    if (referenceId != null &amp;&amp; !referenceId.equals(&quot;NOT_FOUND&quot;)) {
        File file = new File(&quot;transfer_ids_${ctx.getThreadGroup().getName()}.csv&quot;)
        if (!file.exists()) {
            file &lt;&lt; &quot;test_name,thread_group,reference_id,timestamp\n&quot;
        }
        file &lt;&lt; &quot;${__TestPlanName},${ctx.getThreadGroup().getName()},${referenceId},${System.currentTimeMillis()}\n&quot;
    }
}</stringProp>
