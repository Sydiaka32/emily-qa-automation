    vars.put(&quot;ct_token&quot;, token);
    log.info(&quot;Token retrieved: &quot; + token.substring(0, 20) + &quot;...&quot;);
} else {
    log.error(&quot;No token found in properties!&quot;);
    vars.put(&quot;ct_token&quot;, &quot;NOT_FOUND&quot;);
}</stringProp>
