          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.text.SimpleDateFormat

try {
    String status = vars.get(&quot;status&quot;)
    String referenceId = vars.get(&quot;reference_id&quot;)
    String completedAt = vars.get(&quot;completed_at&quot;)
    String createdAt = vars.get(&quot;created_at&quot;)
    
    // Only write if we have a completed status
    if ((status == &quot;COMPLETED&quot; || status == &quot;FAILED&quot; || status == &quot;CLOSED&quot;) &amp;&amp; 
        completedAt != null &amp;&amp; !&quot;null&quot;.equals(completedAt)) {
        
        // Parse the JSON response to get all data
        String responseData = prev.getResponseDataAsString()
        def json = new JsonSlurper().parseText(responseData)
        
        // Get the transfer object
        def transfer = json.content ? json.content[0] : [:]
        
        // Create CSV file for this thread group
        String threadGroupName = ctx.getThreadGroup().getName()
        String fileName = &quot;completed_transfers_&quot; + threadGroupName.replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;_&quot;) + &quot;.csv&quot;
        
        File file = new File(fileName)
        
        // Write header if file doesn&apos;t exist
        if (!file.exists()) {
            file &lt;&lt; &quot;test_name,thread_group,reference_id,status,created_at,completed_at,debtor_xmi,creditor_xmi,amount,currency,response_data,timestamp\n&quot;
        }
        
        // Format timestamp
        def timestamp = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new Date())
        
        // Write data
        file &lt;&lt; &quot;\&quot;${__TestPlanName}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${threadGroupName}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${referenceId}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${status}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${createdAt}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${completedAt}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${transfer.debtor?.xmi ?: &apos;N/A&apos;}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${transfer.creditor?.xmi ?: &apos;N/A&apos;}\&quot;,&quot;
        file &lt;&lt; &quot;${transfer.amount ?: &apos;0&apos;},&quot; 
        file &lt;&lt; &quot;\&quot;${transfer.currency ?: &apos;N/A&apos;}\&quot;,&quot;
        file &lt;&lt; &quot;\&quot;${responseData.replace(&apos;&quot;&apos;, &apos;&quot;&quot;&apos;)}\&quot;,&quot;  // Escape quotes in JSON
        file &lt;&lt; &quot;\&quot;${timestamp}\&quot;\n&quot;
        
        log.info(&quot;Wrote completed transfer ${referenceId} to ${fileName}&quot;)
        
        // Also store in variable to stop polling
        vars.put(&quot;transfer_written&quot;, &quot;true&quot;)
    } else {
        log.info(&quot;Transfer ${referenceId} not completed yet or missing data. Status: ${status}&quot;)
    }
} catch (Exception e) {
    log.error(&quot;Error writing transfer to CSV: &quot; + e.getMessage())
}</stringProp>
          </JSR223PostProcessor>
